<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="node" attr.name="keywords" attr.type="string" />
  <key id="d2" for="node" attr.name="description" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="type" attr.type="string" />
  <graph edgedefault="directed">
    <node id="capability::topk_recommendation">
      <data key="d0">Capability</data>
      <data key="d1">Top-K Recommendation Replication</data>
      <data key="d2">Replicate a Top-K recommendation workflow for implicit-feedback movie ranking tasks.</data>
      <data key="d3">["recommendation", "top-k", "ranking", "implicit", "feedback", "recall", "ndcg", "coverage", "movielens"]</data>
    </node>
    <node id="capability::tabular_classification">
      <data key="d0">Capability</data>
      <data key="d1">Tabular Classification Replication</data>
      <data key="d2">Replicate a tabular classification workflow for customer churn and similar binary prediction tasks.</data>
      <data key="d3">["classification", "churn", "tabular", "binary", "prediction", "accuracy", "precision", "recall", "f1"]</data>
    </node>
    <node id="task::movie_homepage">
      <data key="d0">TaskType</data>
      <data key="d1">Movie Homepage Recommendation</data>
      <data key="d2">Homepage or browse-page recommendation for movie platforms.</data>
      <data key="d3">[]</data>
    </node>
    <node id="task::customer_churn">
      <data key="d0">TaskType</data>
      <data key="d1">Customer Churn Prediction</data>
      <data key="d2">Binary classification for customer churn risk in subscription businesses.</data>
      <data key="d3">[]</data>
    </node>
    <node id="algorithm::popularity">
      <data key="d0">Algorithm</data>
      <data key="d1">Popularity Baseline</data>
      <data key="d2">Global item popularity ranking filtered by user history.</data>
      <data key="d3">["baseline", "cold", "start", "explainable", "local", "cpu"]</data>
    </node>
    <node id="algorithm::itemcf">
      <data key="d0">Algorithm</data>
      <data key="d1">Item-Based Collaborative Filtering</data>
      <data key="d2">Recommend unseen items using item-item similarity from user co-occurrence.</data>
      <data key="d3">["collaborative", "filtering", "co-occurrence", "implicit", "feedback", "recall", "ndcg", "top-k"]</data>
    </node>
    <node id="algorithm::genre_affinity">
      <data key="d0">Algorithm</data>
      <data key="d1">Genre Affinity Recommender</data>
      <data key="d2">Recommend unseen items by matching user interaction genres with candidate item genres.</data>
      <data key="d3">["content", "based", "genre", "explainable", "cold", "start", "local", "cpu", "top-k"]</data>
    </node>
    <node id="algorithm::majority_class">
      <data key="d0">Algorithm</data>
      <data key="d1">Majority Classifier</data>
      <data key="d2">Baseline classifier that predicts the majority label from the training split.</data>
      <data key="d3">["baseline", "classification", "tabular", "churn", "majority", "local", "cpu"]</data>
    </node>
    <node id="algorithm::risk_score">
      <data key="d0">Algorithm</data>
      <data key="d1">Risk Score Classifier</data>
      <data key="d2">Weighted feature score classifier for churn-style binary prediction.</data>
      <data key="d3">["classification", "churn", "scorecard", "tabular", "explainable", "f1", "accuracy", "local", "cpu"]</data>
    </node>
    <node id="metric::recall_at_k">
      <data key="d0">Metric</data>
      <data key="d1">Recall@K</data>
      <data key="d2">Fraction of held-out relevant items found in the Top-K list.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::ndcg_at_k">
      <data key="d0">Metric</data>
      <data key="d1">NDCG@K</data>
      <data key="d2">Position-sensitive ranking quality for Top-K recommendation.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::coverage">
      <data key="d0">Metric</data>
      <data key="d1">Coverage</data>
      <data key="d2">Unique recommended items divided by unique catalog items.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::accuracy">
      <data key="d0">Metric</data>
      <data key="d1">Accuracy</data>
      <data key="d2">Overall fraction of correctly predicted labels.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::precision">
      <data key="d0">Metric</data>
      <data key="d1">Precision</data>
      <data key="d2">Fraction of predicted positives that are true positives.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::recall">
      <data key="d0">Metric</data>
      <data key="d1">Recall</data>
      <data key="d2">Fraction of true positives that are correctly predicted.</data>
      <data key="d3">[]</data>
    </node>
    <node id="metric::f1">
      <data key="d0">Metric</data>
      <data key="d1">F1 Score</data>
      <data key="d2">Harmonic mean of precision and recall.</data>
      <data key="d3">[]</data>
    </node>
    <node id="constraint::implicit_feedback">
      <data key="d0">Constraint</data>
      <data key="d1">Implicit Feedback Only</data>
      <data key="d2">Training data is reduced to positive interactions.</data>
      <data key="d3">[]</data>
    </node>
    <node id="constraint::local_cpu">
      <data key="d0">Constraint</data>
      <data key="d1">Local CPU Execution</data>
      <data key="d2">Algorithm must run on local CPU without external services.</data>
      <data key="d3">[]</data>
    </node>
    <node id="constraint::tabular_features">
      <data key="d0">Constraint</data>
      <data key="d1">Structured Tabular Features</data>
      <data key="d2">Inputs are structured tabular features with a binary target.</data>
      <data key="d3">[]</data>
    </node>
    <node id="template::popularity_py">
      <data key="d0">CodeTemplate</data>
      <data key="d1">Popularity Python Template</data>
      <data key="d2">Template for the popularity baseline.</data>
      <data key="d3">[]</data>
    </node>
    <node id="template::itemcf_py">
      <data key="d0">CodeTemplate</data>
      <data key="d1">ItemCF Python Template</data>
      <data key="d2">Template for the item-based collaborative filtering baseline.</data>
      <data key="d3">[]</data>
    </node>
    <node id="template::genre_affinity_py">
      <data key="d0">CodeTemplate</data>
      <data key="d1">Genre Affinity Python Template</data>
      <data key="d2">Template for the genre affinity recommender.</data>
      <data key="d3">[]</data>
    </node>
    <node id="template::majority_class_py">
      <data key="d0">CodeTemplate</data>
      <data key="d1">Majority Class Python Template</data>
      <data key="d2">Template for the majority-label churn baseline.</data>
      <data key="d3">[]</data>
    </node>
    <node id="template::risk_score_py">
      <data key="d0">CodeTemplate</data>
      <data key="d1">Risk Score Python Template</data>
      <data key="d2">Template for the weighted churn risk classifier.</data>
      <data key="d3">[]</data>
    </node>
    <node id="failure::seen_items">
      <data key="d0">FailurePattern</data>
      <data key="d1">Seen Item Leakage</data>
      <data key="d2">Recommended list contains items already observed in training history.</data>
      <data key="d3">[]</data>
    </node>
    <node id="failure::empty_list">
      <data key="d0">FailurePattern</data>
      <data key="d1">Empty Recommendation List</data>
      <data key="d2">Candidate fails to emit Top-K items for one or more users.</data>
      <data key="d3">[]</data>
    </node>
    <node id="failure::unsafe_code">
      <data key="d0">FailurePattern</data>
      <data key="d1">Unsafe Code Pattern</data>
      <data key="d2">Generated candidate imports or executes unsafe modules or functions.</data>
      <data key="d3">[]</data>
    </node>
    <node id="failure::prediction_length">
      <data key="d0">FailurePattern</data>
      <data key="d1">Prediction Length Mismatch</data>
      <data key="d2">The number of predicted labels does not match the evaluation set size.</data>
      <data key="d3">[]</data>
    </node>
    <node id="failure::label_cast">
      <data key="d0">FailurePattern</data>
      <data key="d1">Non-Numeric Label Output</data>
      <data key="d2">Predicted labels are not compatible with integer binary targets.</data>
      <data key="d3">[]</data>
    </node>
